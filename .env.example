# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables)

# Catering requests — sent by email through Resend (https://resend.com, free tier is plenty).
# Leave RESEND_API_KEY empty and the form falls back to opening the visitor's email app (old behaviour).
RESEND_API_KEY=
CATERING_TO_EMAIL=elpationv@gmail.com
# Must be an address on a domain verified in Resend. "onboarding@resend.dev" works for testing.
CATERING_FROM_EMAIL=El Patio Website <onboarding@resend.dev>

# Online ordering link (DoorDash today; swap for Square pickup ordering later)
NEXT_PUBLIC_ORDER_URL=https://www.doordash.com/store/el-patio-food-truck-reno-51259023/
