# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables)

# ---- Catering emails via Gmail SMTP ----
# The Gmail account the website sends from.
GMAIL_USER=elpationv@gmail.com
# A Google *App Password* (16 characters), not the normal Gmail password.
# Google Account → Security → turn on 2-Step Verification → App passwords → create one for "El Patio website".
GMAIL_APP_PASSWORD=
# Inbox that receives catering requests (defaults to GMAIL_USER). Comma-separate for more than one.
CATERING_TO_EMAIL=elpationv@gmail.com
# Name shown on the request emails
MAIL_FROM_NAME=El Patio Website
# Send the customer a "we got your request" email (true/false)
CATERING_SEND_CONFIRMATION=true
# Leave GMAIL_APP_PASSWORD empty and the form falls back to opening the visitor's email app.

# Online ordering link (DoorDash today; swap for Square pickup ordering later)
NEXT_PUBLIC_ORDER_URL=https://www.doordash.com/store/el-patio-food-truck-reno-51259023/
